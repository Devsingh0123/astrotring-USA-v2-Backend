# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=astrotring_db
DB_USER=root
DB_PASSWORD=root123

# Redis Cache Configuration (ioredis)
REDIS_URL=redis://127.0.0.1:6379

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMTP Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="AstroTring Support <no-reply@astrotring.com>"

# Frontend Client URL for CORS
FRONTEND_URL=http://localhost:5173

# Vedic Astrology Calculation Engine (Jagannatha Hora Cloud Run)
VEDIC_ENGINE_BASE_URL=https://jagannatha-hora-359167915530.europe-west1.run.app

# OpenAI Configuration (Jyotish & Shastra AI Chat)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
